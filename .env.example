# Telegram: create a bot with @BotFather, then message the bot once.
TELEGRAM_BOT_TOKEN=***REMOVED***
TELEGRAM_CHAT_ID=***REMOVED***

# Optional: configure IMAP to process LinkedIn/Naukri job-alert emails.
# Use an app password where your email provider supports it. Do not use your normal password if app passwords are available.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=your-alert-mailbox@example.com
# IMAP_APP_PASSWORD=replace_with_app_password
# IMAP_FOLDER=INBOX

REQUEST_TIMEOUT=20
REQUEST_DELAY_SECONDS=1
